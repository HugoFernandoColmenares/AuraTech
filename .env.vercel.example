# Vercel project environment variables (copy to Vercel dashboard → Settings → Environment Variables)
# Used by scripts/generate-env.mjs at build time (FORCE_ENV_GENERATE=true in vercel.json).

NG_APP_SUPABASE_URL=https://your-project.supabase.co
NG_APP_SUPABASE_ANON_KEY=your-anon-key

NG_APP_PRODUCTION=true
NG_APP_DEBUG_MODE=false
