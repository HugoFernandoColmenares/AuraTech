# ═══════════════════════════════════════════════════════════════════════════
# AuraTech — Environment template
# Copy to `.env` for local development. Never commit `.env`.
# On Vercel: add the same keys in Project → Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (Angular browser — safe to expose via NG_APP_ prefix) ──────────
# Project URL: https://<project-ref>.supabase.co
NG_APP_SUPABASE_URL=
# Anon/public key (RLS must be enabled on all tables)
NG_APP_SUPABASE_ANON_KEY=
NG_APP_DEBUG_MODE=true
NG_APP_PRODUCTION=false
# true = localStorage demo (no Supabase traffic). false = use NG_APP_SUPABASE_* .
NG_APP_DEMO_MODE=true

# ── Vercel / CI / Supabase CLI ONLY — NEVER prefix with NG_APP_ ─────────────
# Do NOT import these in Angular src/app code.
SUPABASE_PROJECT_REF=
# Database password (Settings → Database → Connection string) for: npm run db:sync
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
